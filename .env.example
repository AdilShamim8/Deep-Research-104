# ──────────────────────────────────────────────────────────────────────────────
# Deep Research 104 — Environment Variable Reference
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Target environment date: 17 October 2026
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
APP_NAME=deep-research-104
APP_PORT=8000
APP_WORKERS=4                             # Uvicorn worker count (production)

# ── Redis (cache + rate limiting + idempotency) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ── OpenAI / o-family reasoning models ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_DEFAULT_MODEL=o3-mini
OPENAI_REASONING_MODEL=o3
OPENAI_REASONING_EFFORT=medium            # low | medium | high
OPENAI_REQUEST_TIMEOUT=120
OPENAI_MAX_RETRIES=3

# ── DeepSeek (R1 reasoning) ──────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DEEPSEEK_REQUEST_TIMEOUT=180
DEEPSEEK_MAX_RETRIES=3

# ── Local model (Ollama / vLLM / llama.cpp) ─────────────────────────────────
LOCAL_MODEL_TYPE=ollama                   # ollama | vllm | llamacpp
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
LOCAL_MODEL_PATH=./models

# ── Web search providers ─────────────────────────────────────────────────────
SEARCH_PROVIDER=duckduckgo                # serpapi | brave | bing | duckduckgo
SERPAPI_KEY=
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT_SECONDS=15
MAX_CONTENT_LENGTH=8000

# ── Reasoning pipeline ────────────────────────────────────────────────────────
MAX_TOKENS_PER_REQUEST=128000
REASONING_BUDGET=32768
MAX_OUTPUT_TOKENS=8192
PARALLEL_SAMPLES=3
SEQUENTIAL_STEPS=5
TEMPERATURE=0.7
TOP_P=0.9

# ── Tree of Thoughts ──────────────────────────────────────────────────────────
TOT_BRANCHING_FACTOR=3
TOT_MAX_DEPTH=4
TOT_BEAM_WIDTH=2

# ── Research loop ────────────────────────────────────────────────────────────
MAX_RESEARCH_ITERATIONS=5
MAX_SEARCH_PER_ITERATION=3
MAX_CONTEXT_TOKENS=24000

# ── Security (API gateway) ───────────────────────────────────────────────────
API_KEY_HEADER=x-api-key                  # clients send this header
JWT_SECRET=                                # 32+ char random string in prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=https://deepresearch.space-z.ai
RATE_LIMIT_RPM=60                          # requests per minute per key
RATE_LIMIT_BURST=10
REQUEST_MAX_BODY_BYTES=1048576             # 1 MiB

# ── Observability ────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=deep-research-104
SENTRY_DSN=

# ── Storage (research results persistence) ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://deep:deep@localhost:5432/deep_research
STORAGE_BACKEND=postgres                   # postgres | sqlite | memory
